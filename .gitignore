# Tool run state written under the cwd; never source.
.aw/
.local/
.benchmarks/
.baselines/

# Per-run scratch left by dispatched agents; only agents/, skills/ and plugins/
# are source under .agents/.
.agents/*
!.agents/agents/
!.agents/skills/
!.agents/plugins/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
.mcp.json

# Python, Node and environment files.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
.env.*
!.env.example

# Editors and OS.
.vscode/
.idea/
*.swp
.DS_Store

# Cargo build output.
/target/
